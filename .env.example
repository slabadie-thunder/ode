# Web settings UI server
# ODE_WEB_HOST=127.0.0.1
# ODE_WEB_PORT=9293

# API key for the web server (required when exposing the server publicly, e.g. on AWS).
# When set, all /api/* requests must include the key via:
#   Authorization: Bearer <key>   or   X-API-Key: <key>
# The Lark webhook paths (/api/lark/event, /api/lark-event) are exempt — they use
# Lark's own signature verification.
# Generate a strong key: openssl rand -hex 32
# ODE_API_KEY=

# Session inspector / harness Redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Optional default Lark app credentials for action API
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_LONG_CONNECTION=true
